# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Project URL & Anon Public Key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n Webhook 1 URL for RFP Form Data submission workflow (Production)
VITE_N8N_WEBHOOK1_URL="https://limeade-spiffy-uneasily.ngrok-free.dev/webhook/form-rfp"

# n8n Webhook 2 URL for Lemon Squeezy payment events workflow (Production)
VITE_N8N_WEBHOOK_URL="https://limeade-spiffy-uneasily.ngrok-free.dev/webhook/Lemon-RFP"

# Lemon Squeezy Checkout Link URL
VITE_LEMON_SQUEEZY_PAYMENT_LINK=

# Stripe Payment Link URL
VITE_STRIPE_PAYMENT_LINK=
